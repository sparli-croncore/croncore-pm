# ──────────────────────────────────────────────────────────────────────────
# CroncorePM — environment configuration
# Copy to `.env.local` (local dev) or set in Vercel project settings (deploy).
# ──────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres via Vercel Marketplace) ───────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── LLM provider selection ────────────────────────────────────────────────────
# Which brain to use by default: "api" or "subscription".
# - "api"          → Anthropic Messages API (needs ANTHROPIC_API_KEY). Runs anywhere, incl. Vercel.
# - "subscription" → Claude Code / Agent SDK using your Claude Max plan (needs CLAUDE_CODE_OAUTH_TOKEN).
#                    LOCAL / SELF-HOSTED ONLY — cannot run on Vercel serverless.
# The dashboard can override this per environment; on Vercel, "subscription" is auto-disabled.
LLM_PROVIDER="api"

# ── Provider A: Anthropic API key (pay-as-you-go) ─────────────────────────────
# Create at https://console.anthropic.com — billed per token. Required for the deployed agent.
ANTHROPIC_API_KEY="sk-ant-api03-..."
# Models (override only if you know why)
LLM_MODEL_SMART="claude-opus-4-8"
LLM_MODEL_CHEAP="claude-haiku-4-5"

# ── Provider B: Claude subscription via Claude Code (local/self-hosted only) ──
# Generate with:  claude setup-token   (requires Claude Pro/Max; token lasts ~1 year)
# Leave blank when deploying to Vercel.
CLAUDE_CODE_OAUTH_TOKEN=""
# CLI model alias for the subscription provider: opus | sonnet | haiku | fable
LLM_SUBSCRIPTION_MODEL="opus"

# ── ClickUp (shared account; per-project list IDs live in the DB) ─────────────
# Personal token from ClickUp → Settings → Apps. Comments/tasks post as you.
CLICKUP_API_TOKEN="pk_..."

# ── GitHub (shared PAT; per-project repos live in the DB) ─────────────────────
# Fine-grained PAT with read access to your repos (Contents: Read; Pull requests: Read).
GITHUB_TOKEN="github_pat_..."

# ── Gmail (croncore@gmail.com — drafts by default, send on command) ───────────
# OAuth client from Google Cloud Console (Gmail API enabled).
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER="croncore@gmail.com"

# ── Cron / security ───────────────────────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/* so only the scheduler can trigger it.
CRON_SECRET="generate-a-long-random-string"
